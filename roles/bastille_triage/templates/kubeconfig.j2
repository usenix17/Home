apiVersion: v1
kind: Config
clusters:
  - name: starnix
    cluster:
      server: {{ triage_kube_server }}
      certificate-authority-data: {{ vault_triage_kube_ca | b64encode }}
users:
  - name: triage-agent
    user:
      token: {{ vault_triage_kube_token }}
contexts:
  - name: triage-agent
    context:
      cluster: starnix
      user: triage-agent
current-context: triage-agent
