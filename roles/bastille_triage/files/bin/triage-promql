#!/usr/bin/env python3
# pylint: disable=invalid-name
"""Runs a read-only PromQL query against the fixed Prometheus."""
import argparse
import json
import math
import os
import sys
import time
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.dirname(
    os.path.realpath(__file__))))
# pylint: disable=wrong-import-position
from triage import wrapperlib

BASE = "https://prometheus.starnix.net/api/v1"
MAX_POINTS = 200


def main(argv: list[str] | None = None) -> int:
    """Entry point.

    Args:
      argv: Argument list; defaults to sys.argv[1:].

    Returns:
      The process exit code.
    """
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("query", help="PromQL expression")
    parser.add_argument("--range", type=wrapperlib.minutes_arg, dest="minutes",
                        help="look back N minutes (1..1440)")
    args = parser.parse_args(argv)
    params = {"query": args.query}
    path = "/query"
    if args.minutes:
        now = int(time.time())
        seconds = args.minutes * 60
        params.update(
            start=now - seconds, end=now,
            step=max(1, math.ceil(seconds / MAX_POINTS)))
        path = "/query_range"
    url = BASE + path + "?" + urllib.parse.urlencode(params)
    try:
        body = wrapperlib.fetch(
            urllib.request.Request(url, method="GET"))
    except wrapperlib.WrapperError as err:
        return wrapperlib.report_error(err)
    text = body.decode("utf-8", "replace")
    try:
        text = json.dumps(json.loads(text), separators=(",", ":"))
    except ValueError:
        pass
    wrapperlib.emit(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
