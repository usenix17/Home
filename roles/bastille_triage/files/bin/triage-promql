#!/usr/local/bin/python3.11 -I
# pylint: disable=invalid-name
"""Runs a read-only PromQL query against the fixed Prometheus."""
import argparse
import json
import math
import os
import sys
import time
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.dirname(
    os.path.realpath(__file__))))
# pylint: disable=wrong-import-position
from triage import masking  # noqa: E402
from triage import wrapperlib  # noqa: E402

BASE = "https://prometheus.starnix.net/api/v1"
MAX_POINTS = 200
# Points per line when a series is too long for one line.
CHUNK = 50


def _compact(value: object) -> str:
    """Returns value as JSON on one line."""
    return json.dumps(value, separators=(",", ":"))


def _series(item: dict) -> list[str]:
    """Prints a series on one line, or in parts if that is too long."""
    line = _compact(item)
    if len(line) <= masking.MAX_LINE:
        return [line]
    lines = [_compact({k: v for k, v in item.items()
                       if not isinstance(v, list)})]
    for key, value in item.items():
        if isinstance(value, list):
            lines += [_compact({key: value[i:i + CHUNK]})
                      for i in range(0, len(value), CHUNK)]
    return lines


def render(text: str) -> str:
    """Puts each series of a response on its own line.

    The masking hides an overlong line whole, so one line for everything
    would hide every result.

    Args:
      text: The response body.

    Returns:
      The text to print.
    """
    try:
        body = json.loads(text)
    except ValueError:
        return text
    data = body.get("data") if isinstance(body, dict) else None
    found = data.get("result") if isinstance(data, dict) else None
    if not isinstance(found, list) or not all(
            isinstance(item, dict) for item in found):
        return _compact(body)
    lines = [f"{data.get('resultType')}: {len(found)} series"]
    lines += [f"{key}: {_compact(body[key])}"
              for key in ("warnings", "infos") if body.get(key)]
    for item in found:
        lines += _series(item)
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    """Entry point.

    Args:
      argv: Argument list; defaults to sys.argv[1:].

    Returns:
      The process exit code.
    """
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("query", help="PromQL expression")
    parser.add_argument("--range", type=wrapperlib.minutes_arg, dest="minutes",
                        help="look back N minutes (1..1440)")
    args = parser.parse_args(argv)
    params = {"query": args.query}
    path = "/query"
    if args.minutes:
        now = int(time.time())
        seconds = args.minutes * 60
        params.update(
            start=now - seconds, end=now,
            step=max(1, math.ceil(seconds / MAX_POINTS)))
        path = "/query_range"
    url = BASE + path + "?" + urllib.parse.urlencode(params)
    try:
        body = wrapperlib.fetch(
            urllib.request.Request(url, method="GET"))
    except wrapperlib.WrapperError as err:
        return wrapperlib.report_error(err)
    wrapperlib.emit(render(body.decode("utf-8", "replace")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
