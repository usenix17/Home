# {{ ansible_managed }}
# Out-of-cluster watcher. Probes by IP where possible; app-level checks live in
# the in-cluster Gatus (ArgoCD applications/gatus).

web:
  port: {{ watcher_gatus_port }}

storage:
  type: sqlite
  path: {{ watcher_gatus_db }}/data.db

alerting:
  discord:
    webhook-url: "{{ watcher_discord_webhook }}"
    title: ":telescope: Watcher (beastyboi)"
    default-alert:
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true
  # AI triage (roles/bastille_triage). It ignores resolved alerts.
  custom:
    url: "{{ watcher_triage_url }}/gatus"
    method: "POST"
    headers:
      Authorization: "Bearer {{ watcher_triage_token }}"
      Content-Type: "application/json"
    body: >-
      {"endpoint":"[ENDPOINT_GROUP]/[ENDPOINT_NAME]","status":"[ALERT_TRIGGERED_OR_RESOLVED]","description":"[ALERT_DESCRIPTION]","errors":"[RESULT_ERRORS]"}
    default-alert:
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: false

endpoints:
{% for n in watcher_talos_nodes %}
  - name: "{{ n.name }} Talos API"
    group: "talos"
    url: "tcp://{{ n.ip }}:50000"
    interval: 30s
    conditions:
      - "[CONNECTED] == true"
    alerts:
      - type: discord
      - type: custom
{% if n.control_plane | default(false) %}
  - name: "{{ n.name }} kube-apiserver"
    group: "talos"
    url: "tcp://{{ n.ip }}:6443"
    interval: 30s
    conditions:
      - "[CONNECTED] == true"
    alerts:
      - type: discord
      - type: custom
{% endif %}
{% endfor %}
  - name: "Traefik ingress"
    group: "cluster"
    url: "tcp://{{ watcher_ingress_ip }}:443"
    interval: 30s
    conditions:
      - "[CONNECTED] == true"
    alerts:
      - type: discord
      - type: custom
{% for d in watcher_dns_servers %}
  - name: "DNS {{ d.name }}"
    group: "dns"
    url: "{{ d.ip }}"
    interval: 60s
    dns:
      query-name: "{{ watcher_dns_probe_name }}"
      query-type: "A"
    conditions:
      - "[DNS_RCODE] == NOERROR"
      - "[BODY] == {{ watcher_ingress_ip }}"
    alerts:
      - type: discord
      - type: custom
{% endfor %}
{% for c in watcher_http_checks %}
  - name: "{{ c.name }}"
    group: "{{ c.group }}"
    url: "{{ c.url }}"
    interval: 60s
    client:
      timeout: 10s
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: discord
      - type: custom
{% endfor %}
{% for c in watcher_tcp_checks %}
  - name: "{{ c.name }}"
    group: "{{ c.group }}"
    url: "tcp://{{ c.target }}"
    interval: 60s
    conditions:
      - "[CONNECTED] == true"
    alerts:
      - type: discord
      - type: custom
{% endfor %}
  # Discord only: a custom alert here would ask triage to triage itself.
  - name: "triage /health"
    group: "infra"
    url: "{{ watcher_triage_url }}/health"
    interval: 60s
    client:
      timeout: 10s
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: discord

# Dead man's switch: the in-cluster Alertmanager posts its always-firing
# Watchdog to /api/v1/endpoints/cluster_alertmanager-watchdog/external.
# Silence means Prometheus, Alertmanager or the whole cluster is down.
external-endpoints:
  - name: "alertmanager-watchdog"
    group: "cluster"
    token: "{{ watcher_push_token }}"
    heartbeat:
      interval: {{ watcher_heartbeat_interval }}
    alerts:
      - type: discord
        failure-threshold: 1
        description: "In-cluster alerting has gone silent (no Watchdog heartbeat)"
      - type: custom
        failure-threshold: 1
        description: "In-cluster alerting has gone silent (no Watchdog heartbeat)"
