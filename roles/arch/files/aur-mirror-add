#!/usr/bin/env bash
# aur-mirror-add — manage aur-mirror allowlist membership with AUR dependency
# awareness. Official-repo deps are ignored (pacman/makepkg resolve those);
# only AUR packages live in the allowlist.
#
#   add (default): resolve a package's AUR closure, report/append what's missing
#   --remove:      remove a package AND any deps it leaves orphaned (deps that
#                  no other approved package still needs)
set -euo pipefail

ALLOWLIST="${AUR_ALLOWLIST:-$HOME/ArgoCD/applications/aur-mirror/allowlist.yaml}"
IMAGE="${AUR_BUILDER_IMAGE:-registry.starnix.net/library/aur-builder:latest}"

usage() {
  cat <<'EOF'
aur-mirror-add — manage aur-mirror allowlist membership.

Usage:
  aur-mirror-add <package>...            show allowlist entries the package needs
  aur-mirror-add --apply <package>...    append the missing entries
  aur-mirror-add --remove <package>...   remove the package + newly-orphaned deps

Environment:
  AUR_ALLOWLIST      path to allowlist.yaml
                     (default: $HOME/ArgoCD/applications/aur-mirror/allowlist.yaml)
  AUR_BUILDER_IMAGE  image providing `aur` when aurutils isn't installed locally
EOF
}

mode=add
pkgs=()
for arg in "$@"; do
  case "$arg" in
    --apply)   mode=apply ;;
    --remove)  mode=remove ;;
    -h|--help) usage; exit 0 ;;
    -*)        echo "unknown option: $arg" >&2; exit 2 ;;
    *)         pkgs+=("$arg") ;;
  esac
done
[ "${#pkgs[@]}" -gt 0 ] || { usage; exit 2; }
[ -f "$ALLOWLIST" ] || { echo "allowlist not found: $ALLOWLIST" >&2; exit 1; }

aur_depends() {  # prefer local aurutils, else the builder image
  if command -v aur >/dev/null 2>&1; then aur depends -n "$@"
  else docker run --rm "$IMAGE" aur depends -n "$@"; fi
}
# All unique AUR package names in the closure of the given packages.
closure() { aur_depends "$@" 2>/dev/null | tr '\t' '\n' | sed '/^$/d' | sort -u; }

approved_names() { grep -oP '^\s*-\s*name:\s*\K\S+' "$ALLOWLIST" | sort -u; }
# "root" packages: those marked explicit (the things you install directly).
explicit_names() {
  awk '$1=="-"&&$2=="name:"{n=$3} $1=="note:"&&$2=="explicit"{print n}' "$ALLOWLIST" | sort -u
}

is_requested() { local n; for n in "${pkgs[@]}"; do [ "$n" = "$1" ] && return 0; done; return 1; }

if [ "$mode" = remove ]; then
  echo "Resolving dependency closures (this can take a moment)..." >&2
  target="$(closure "${pkgs[@]}")"
  # Everything still required by the OTHER explicit roots.
  mapfile -t roots < <(explicit_names | grep -vxF -f <(printf '%s\n' "${pkgs[@]}") || true)
  if [ "${#roots[@]}" -gt 0 ]; then needed="$(closure "${roots[@]}")"; else needed=""; fi

  # Removable = (target closure) - (still needed), limited to what's in the file.
  removable="$(comm -23 <(printf '%s\n' "$target") <(printf '%s\n' "$needed") \
              | comm -12 - <(approved_names))"

  kept="$(comm -23 <(printf '%s\n' "${pkgs[@]}" | sort -u) <(printf '%s\n' "$removable"))"
  [ -z "$kept" ] || while IFS= read -r k; do [ -n "$k" ] &&
    echo "keep:   $k — still required by another approved package" >&2; done <<< "$kept"

  if [ -z "$removable" ]; then
    echo "Nothing removable: requested package(s) are still required by others." >&2
    exit 0
  fi

  echo "# Removing $(printf '%s\n' "$removable" | grep -c .) entr$([ "$(printf '%s\n' "$removable" | grep -c .)" -eq 1 ] && echo y || echo ies):"
  while IFS= read -r n; do [ -n "$n" ] &&
    { is_requested "$n" && echo "  - $n (requested)" || echo "  - $n (orphaned dep)"; }; done <<< "$removable"

  rmfile="$(mktemp)"; printf '%s\n' "$removable" > "$rmfile"
  tmp="$(mktemp)"
  awk -v rmfile="$rmfile" '
    BEGIN { while ((getline l < rmfile) > 0) rm[l]=1 }
    skip > 0 { skip--; next }
    $1=="-" && $2=="name:" && ($3 in rm) { skip=2; next }
    { print }
  ' "$ALLOWLIST" > "$tmp"
  mv "$tmp" "$ALLOWLIST"; rm -f "$rmfile"
  echo "Review:  git -C $(dirname "$ALLOWLIST") diff -- $(basename "$ALLOWLIST")"
  exit 0
fi

# add / apply
target="$(closure "${pkgs[@]}")"
[ -n "$target" ] || { echo "no AUR packages resolved for: ${pkgs[*]} (official-repo only?)" >&2; exit 1; }
missing="$(comm -23 <(printf '%s\n' "$target") <(approved_names))"

if [ -z "$missing" ]; then
  echo "✓ ${pkgs[*]} and all AUR deps already present in $ALLOWLIST"; exit 0
fi
gen() {
  while IFS= read -r name; do [ -n "$name" ] || continue
    if is_requested "$name"; then note=explicit; else note=dependency; fi
    printf '      - name: %s\n        approved: true\n        note: %s\n' "$name" "$note"
  done <<< "$missing"
}
count="$(printf '%s\n' "$missing" | grep -c .)"
if [ "$mode" = apply ]; then
  gen >> "$ALLOWLIST"
  echo "Appended $count entr$([ "$count" -eq 1 ] && echo y || echo ies) to $ALLOWLIST"
  echo "Review:  git -C $(dirname "$ALLOWLIST") diff -- $(basename "$ALLOWLIST")"
else
  echo "# $count package(s) missing from the allowlist (append with --apply):"; gen
fi
