# Managed by Ansible (roles/syslog).
# rsyslog runs ONLY as a Graylog relay on FreeBSD: native syslogd still owns
# /dev/log and writes the local /var/log files. This config does NOT load
# imuxsock (so it won't fight syslogd) and writes no local files -- it just
# receives syslogd's loopback forward and re-emits it to Graylog in RFC5424.
module(load="imudp")
input(type="imudp" address="127.0.0.1" port="10514")

# RFC5424 output, but with the source hostname pinned to this host. The relayed
# messages arrive over loopback carrying whatever hostname syslogd stamped
# (often "localhost"), so we override it here instead of trusting %HOSTNAME%.
template(name="GraylogForward" type="string"
  string="<%PRI%>1 %TIMESTAMP:::date-rfc3339% {{ inventory_hostname_short }} %APP-NAME% %PROCID% %MSGID% %STRUCTURED-DATA% %msg%\n")

*.* action(type="omfwd"
    target="{{ syslog_target_host }}"
    port="{{ syslog_target_port }}"
    protocol="udp"
    template="GraylogForward")
