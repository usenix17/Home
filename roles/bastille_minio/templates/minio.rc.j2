#!/bin/sh
#
# {{ ansible_managed }}
# PROVIDE: minio
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# MinIO S3-compatible object storage. Reads MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# from {{ '${minio_env_file}' }} (default /usr/local/etc/minio.env, mode 0600).

. /etc/rc.subr

name="minio"
rcvar="${name}_enable"
desc="MinIO S3-compatible object storage"

load_rc_config "$name"

: ${minio_enable:="NO"}
: ${minio_user:="{{ minio_user }}"}
: ${minio_group:="{{ minio_group }}"}
: ${minio_data:="{{ minio_data_dst }}"}
: ${minio_address:="{{ minio_api_address }}"}
: ${minio_console_address:="{{ minio_console_address }}"}
: ${minio_env_file:="/usr/local/etc/minio.env"}
: ${minio_extra_flags:=""}

command="/usr/local/bin/minio"
pidfile="/var/run/${name}/${name}.pid"
logfile="/var/log/${name}/${name}.log"

required_files="${command}"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

minio_start()
{
	if minio_status_quiet; then
		echo "${name} is already running as pid $(cat ${pidfile})." >&2
		return 1
	fi

	for port in 9000 9001; do
		if sockstat -4 -l -p "${port}" 2>/dev/null | tail -n +2 | grep -q .; then
			echo "ERROR: port ${port} already in use:" >&2
			sockstat -4 -l -p "${port}" >&2
			return 1
		fi
	done

	# Runtime dirs
	install -d -o "${minio_user}" -g "${minio_group}" -m 0750 \
		"$(dirname "${pidfile}")" || return 1
	install -d -o "${minio_user}" -g "${minio_group}" -m 0750 \
		"$(dirname "${logfile}")" || return 1

	:> "${logfile}" && chown "${minio_user}:${minio_group}" "${logfile}"

	# Source credentials/env
	if [ -f "${minio_env_file}" ]; then
		set -a
		. "${minio_env_file}"
		set +a
	else
		echo "WARNING: ${minio_env_file} not found; starting without env vars" >&2
	fi

	echo "Starting ${name}."

	/usr/sbin/daemon \
		-f \
		-P "${pidfile}" \
		-u "${minio_user}" \
		-o "${logfile}" \
		-t "${name}" \
		"${command}" server \
			--address "${minio_address}" \
			--console-address "${minio_console_address}" \
			${minio_extra_flags} \
			"${minio_data}"

	rc=$?
	if [ $rc -ne 0 ]; then
		echo "ERROR: daemon(8) returned ${rc}" >&2
		return $rc
	fi

	sleep 2
	if minio_status_quiet; then
		echo "${name} started, pid $(cat ${pidfile})."
	else
		echo "ERROR: ${name} did not stay running; tail of log:" >&2
		tail -20 "${logfile}" >&2
		return 1
	fi
}

minio_stop()
{
	if ! minio_status_quiet; then
		echo "${name} is not running."
		return 1
	fi
	pid=$(cat "${pidfile}")
	echo "Stopping ${name}."
	kill -TERM "${pid}" 2>/dev/null
	n=0
	while [ $n -lt 30 ] && kill -0 "${pid}" 2>/dev/null; do
		sleep 1
		n=$((n + 1))
	done
	if kill -0 "${pid}" 2>/dev/null; then
		kill -KILL "${pid}" 2>/dev/null
	fi
	rm -f "${pidfile}"
}

minio_status()
{
	if minio_status_quiet; then
		echo "${name} is running as pid $(cat ${pidfile})."
		return 0
	fi
	echo "${name} is not running."
	return 1
}

minio_status_quiet()
{
	[ -f "${pidfile}" ] || return 1
	pid=$(cat "${pidfile}" 2>/dev/null)
	[ -n "${pid}" ] || return 1
	kill -0 "${pid}" 2>/dev/null
}

run_rc_command "$1"
